# Copy this file to .env and fill in your own credentials. .env is gitignored.

# YouTube: an API key is enough. Free, 10,000 quota units a day.
#   console.cloud.google.com -> new project -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# Twitch: a client ID and secret, which get exchanged for a token at runtime.
#   dev.twitch.tv/console -> Register Your Application
#   redirect URL http://localhost, category Application Integration
# The secret is a secret. It never goes in a browser page, which is why the web
# version of this project is YouTube only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
